<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Custom favicon -->
    <template id="layout" inherit_id="web.layout" name="Naman Custom Web Layout">
        <xpath expr="//link[@rel='shortcut icon']" position="replace">
            <link rel="shortcut icon" href="/naman_custom_layout/static/src/img/naman%20logo.png" type="image/png"/>
        </xpath>
    </template>

    <!-- 2. Remove "Manage Databases | Powered by Odoo" footer -->
    <template id="login_layout" inherit_id="web.login_layout" name="Naman Custom Login Layout">
        <xpath expr="//div[contains(@class, 'text-center') and contains(@class, 'small') and contains(@class, 'border-top')]" position="replace">
            <!-- empty -->
        </xpath>
    </template>

    <!-- 3. Remove "Use a Passkey" and "- or -" section -->
    <template id="login_oauth" inherit_id="web.login_oauth" name="Naman Custom Login OAuth">
        <xpath expr="//div[contains(@class, 'o_login_auth')]" position="replace">
            <!-- empty -->
        </xpath>
    </template>

    <!-- 4. Remove "Don't have an account?" signup link -->
    <template id="login" inherit_id="auth_signup.login" name="Naman Custom Signup Login">
        <xpath expr="//a[contains(@t-attf-href, '/web/signup')]" position="replace">
            <!-- empty -->
        </xpath>
    </template>
</odoo>
